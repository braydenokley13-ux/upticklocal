node_modules
.next
out
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Generated by `next dev` — Next.js writes these agent rule files on every run.
AGENTS.md
CLAUDE.md

# Blender plate frame sequences are rebuilt by scripts/film-plates.sh; only the encoded plates are kept
public/film-rd/plates/seq
# The proxy lane in full: it is the cheap lane by design (640x360/8spp, ~7 s a frame against 50),
# rebuilt from the same cameras by scripts/film-proxy.sh whenever a cut needs judging. Committing
# it would put a disposable photograph of the film in the history beside the real one.
public/film-rd/plates/proxy
blender/assets/*.blend
blender/assets/*.blend1

# Python bytecode from the Blender scripts
__pycache__/

# Synthesised sound stems are rebuilt by `python3 film/audio/synth.py`; only the compressed cues used by the edit are kept
public/film-rd/audio/*.wav

# Finished plate frames, hard-linked so a re-run of a chain does not pay for them twice
blender/.plate-cache
blender/screens

# Baked screen PNG sequences — rebuilt by scripts/bake-screens.sh from the Remotion compositions
blender/screens

# Blender plate frame cache (hard links)
blender/.plate-cache

# Per-shot review stills are cut from the previews by scripts/film-sheet.py; the contact sheets are the record
public/film-rd/renders/stills

# Proof cuts are re-rendered from the timeline by scripts/film-proof.sh; the contact sheets beside them are the record
film/review/proof/*.mp4
film/review/frames
